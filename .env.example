# Dev / локальная разработка. Для псевдо-prod на сервере см. deploy/prod/.env.prod.example
# и скрипт ./deploy/prod/generate-env.sh
# Все переменные валидируются в backend/project_config.py (pydantic-settings).

ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5437/gymtracker

# Auth (AuthX, JWT cookies)
AUTH_SECRET=gymtracker-dev-auth-secret-min-32-chars-change-in-prod

# TTL
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# Cookies
# COOKIE_SECURE=1 в prod (HTTPS)
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# CORS для backend (docker-compose.dev.yml пробрасывает в контейнер backend)
# CORS_ALLOWED_ORIGINS — точные origin через запятую (приоритет над regex, если не пусто)
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:8081,http://localhost:5173
# CORS_ALLOW_ORIGIN_REGEX — по умолчанию в compose: localhost + 192.168.x.x + 10.x.x.x (любой порт)
# CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3})(:\d+)?$

# Redis (обязателен: rate limit; опционально кэш GET). В Docker Compose: REDIS_HOST=redis_container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_GUI_PORT=5540
# Кэш GET (fastapi-cache2). 0 — только для отладки stale-ответов после мутаций
ENABLE_REDIS_CACHE=0

# Скрипты и HTTP-тесты (префикс GYMTRACKER_)
# GYMTRACKER_HTTP_BASE=http://127.0.0.1:8000
# GYMTRACKER_LOGIN=
# GYMTRACKER_PASSWORD=

# SMTP (TGL-38). В Docker dev по умолчанию maildev:1025, UI http://localhost:1080
# SMTP_HOST=maildev
# SMTP_PORT=1025
# SMTP_FROM=noreply@habitpro.ru
# PUBLIC_APP_URL=http://127.0.0.1:8000
# Реальный SMTP (prod): SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_USE_TLS=1 SMTP_USER=... SMTP_PASSWORD=...