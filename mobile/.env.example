# Скопируй в .env или .env.local (см. mobile/README.md)

# Браузер / iOS-симулятор / Expo web на этом же ПК:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Если порт 8000 занят: `make dev-up` создаст mobile/.env.local с :8001

# Android-эмулятор (хост-машина с точки зрения эмулятора):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Телефон в Wi‑Fi (IP компьютера в LAN, не localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Прод / habitpro — только EAS и Docker prod-сборка, не для expo start:
# EXPO_PUBLIC_API_URL=https://habitpro.ru
