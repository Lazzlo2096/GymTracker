# Шаблон для псевдо-prod. Не используйте значения как есть.
# Сгенерируйте: ./deploy/prod/generate-env.sh  →  .env.prod + deploy/prod/CREDS.generated.txt
# Дополнить существующий файл: ./deploy/prod/patch-env.sh

ENVIRONMENT=production

PUBLIC_DOMAIN=habitpro.ru
EXPO_PUBLIC_API_URL=https://habitpro.ru

POSTGRES_USER=gymtracker
POSTGRES_PASSWORD=CHANGE_ME_use_generate_env_sh
POSTGRES_DB=gymtracker

AUTH_SECRET=CHANGE_ME_min_32_chars_use_generate_env_sh
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

COOKIE_SECURE=0
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=habitpro.ru

CORS_ALLOWED_ORIGINS=https://habitpro.ru,https://www.habitpro.ru
CORS_ALLOW_ORIGIN_REGEX=

# Redis обязателен (backend не стартует без redis_container)
REDIS_HOST=redis_container
REDIS_PORT=6379
REDIS_GUI_PORT=5540
ENABLE_REDIS_CACHE=1
RI_TRUSTEDORIGINS=https://habitpro.ru,https://www.habitpro.ru

PGADMIN_EMAIL=admin@habitpro.ru
PGADMIN_PASSWORD=CHANGE_ME

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
MONITORING_PUBLIC_URL=https://habitpro.ru
GRAFANA_ROOT_URL=https://habitpro.ru/grafana/

CERTBOT_EMAIL=admin@habitpro.ru

NGINX_CONF=./nginx/nginx.prod.bootstrap.conf
NGINX_MONITORING_CONF=./nginx/nginx.prod.monitoring.bootstrap.conf

# OAuth / платежи (опционально)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_DEFAULT_REDIRECT_URI=https://habitpro.ru/api/v1/auth/oauth/google/callback
# VK_OAUTH_CLIENT_ID=
# VK_OAUTH_CLIENT_SECRET=
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=

# SMTP (TGL-38). Без переменных — maildev внутри compose, UI https://habitpro.ru/maildev/
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USE_SSL=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@habitpro.ru
# PUBLIC_APP_URL=https://habitpro.ru
